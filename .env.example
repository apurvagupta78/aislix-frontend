# Aislix frontend environment variables
#
# Copy to .env for local development, or set in Vercel / Cloudflare dashboard.
# Never commit .env — publishable keys only in VITE_* vars below.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# development | staging | production
VITE_APP_ENV=development

# Canonical site URL (invite links, auth redirects). Preview: your Vercel URL.
VITE_APP_URL=https://aislix.com
APP_URL=https://aislix.com

# ---------------------------------------------------------------------------
# Supabase (client — exposed to browser)
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# ---------------------------------------------------------------------------
# Supabase (server — never prefix with VITE_)
# ---------------------------------------------------------------------------

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional second gate for /admin (platform console). Leave unset to use grant table only.
ADMIN_CONSOLE_PASSWORD=

# ---------------------------------------------------------------------------
# Railway AI backend
# ---------------------------------------------------------------------------

# Client-side API client
VITE_API_BASE_URL=https://aislix-backend-production.up.railway.app
VITE_API_BASE_URL_DEV=
VITE_API_BASE_URL_STAGING=
VITE_API_BASE_URL_PROD=

# Landing demo scan (browser → Railway public endpoints)
VITE_AISLIX_API_URL=https://aislix-backend-production.up.railway.app

# Server-side scan proxy (createServerFn / API routes)
AISLIX_AI_API_URL=https://aislix-backend-production.up.railway.app
AISLIX_AI_API_KEY=
AISLIX_AI_TIMEOUT_MS=180000

VITE_API_TIMEOUT_MS=20000
VITE_API_UPLOAD_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Email (Lovable managed — required until migrated to Resend)
# ---------------------------------------------------------------------------

LOVABLE_API_KEY=
LOVABLE_SEND_URL=

# ---------------------------------------------------------------------------
# Ask Aislix (server — never prefix with VITE_)
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_HELP_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
ASK_AISLIX_MAX_TOOL_ROUNDS=5
ASK_AISLIX_REQUEST_TIMEOUT_MS=45000
ASK_AISLIX_MAX_MESSAGES=10
ASK_AISLIX_RATE_LIMIT_USER_PER_HOUR=30
ASK_AISLIX_RATE_LIMIT_ORG_PER_HOUR=200

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------

VITE_GA_MEASUREMENT_ID=G-G6Q8XHGPG1
