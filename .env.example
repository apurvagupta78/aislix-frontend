# Aislix frontend environment variables
#
# Copy to .env (development) or set in the hosting environment.
# The frontend only reads VITE_-prefixed values; no secrets belong here.

# development | staging | production
VITE_APP_ENV=development

# Railway FastAPI base URL used by every API call.
VITE_API_BASE_URL=
# Optional per-environment overrides (take precedence over VITE_API_BASE_URL).
VITE_API_BASE_URL_DEV=
VITE_API_BASE_URL_STAGING=
VITE_API_BASE_URL_PROD=

# Request timeouts in milliseconds (optional).
VITE_API_TIMEOUT_MS=20000
VITE_API_UPLOAD_TIMEOUT_MS=120000
